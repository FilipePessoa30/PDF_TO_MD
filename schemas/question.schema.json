{
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "letter": {
          "pattern": "^[A-E]$",
          "title": "Letter",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "letter",
        "text"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "AlternativeDiagnostic": {
      "additionalProperties": false,
      "description": "Diagnosis attached to a single wrong alternative of a question.",
      "properties": {
        "concepts": {
          "items": {
            "type": "string"
          },
          "title": "Concepts",
          "type": "array"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "misconception_id": {
          "title": "Misconception Id",
          "type": "string"
        }
      },
      "required": [
        "misconception_id"
      ],
      "title": "AlternativeDiagnostic",
      "type": "object"
    },
    "AnswerStandardReference": {
      "additionalProperties": false,
      "description": "The official grading rubric (\"padrao de resposta\") for a discursive question.\n\nAdded in Phase 1A after encountering the real 2021 corpus: the answer\nstandard PDF (e.g. ``2021/b3_padrao.pdf``) contains the actual grading\ncriteria text for each discursive question, distinct from both the\nquestion's own source (the \"prova\") and an objective question's\n``correct_answer`` (which comes from the \"gabarito\"). See\ndocs/decisions.md, ADR \"answer_standard for discursive questions\", for\nthe full PROBLEMA/EXEMPLO/LIMITACAO/ALTERACAO/TESTE rationale.\n\nThis is deliberately a *separate* field from ``official_answer_source``\n(which remains a lightweight pointer usable by objective questions) so\nthat existing data is unaffected: this field is optional and additive.\n\n``assets`` (Phase 1C, PROMPT section 9) covers visual elements that\nexist *only* in the answer standard itself - e.g. D4's worked-out\ncircuit diagrams, introduced by \"conforme abaixo\" - as opposed to a\nreprint of the question's own figure (which the padrao PDF also\ncontains for some questions, but that content is already captured via\nthe question's own ``Question.assets`` from the prova and must never\nbe duplicated here). Kept in a field of its own, never merged into\n``Question.assets``, so a future consumer can enforce \"never shown to\nthe student before their attempt\" by field alone - see\ndocs/decisions.md, \"Phase 1C\" ADR.",
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Assets",
          "type": "array"
        },
        "pages": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        },
        "pdf_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pdf Sha256",
          "type": "string"
        },
        "source_path": {
          "description": "path relative to the repo root, e.g. '2021/b3_padrao.pdf'",
          "title": "Source Path",
          "type": "string"
        },
        "text": {
          "description": "verbatim official grading rubric text",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "pdf_sha256",
        "pages",
        "text"
      ],
      "title": "AnswerStandardReference",
      "type": "object"
    },
    "AnswerValidationStatus": {
      "enum": [
        "pending",
        "validated",
        "annulled",
        "conflicting_sources",
        "not_applicable",
        "unknown"
      ],
      "title": "AnswerValidationStatus",
      "type": "string"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "alt_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt Text"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "extraction_method": {
          "$ref": "#/$defs/AssetExtractionMethod",
          "default": "pending"
        },
        "id": {
          "description": "slug unique within the owning question, e.g. 'figure-01'",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "description": "portable path, relative to the owning question's own .md file",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source_page": {
          "minimum": 1,
          "title": "Source Page",
          "type": "integer"
        },
        "type": {
          "$ref": "#/$defs/AssetType"
        }
      },
      "required": [
        "id",
        "type",
        "path",
        "source_page"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetBlock": {
      "additionalProperties": false,
      "description": "A pointer, by id, into ``Question.assets`` - never a copy of the\nasset's own fields, so there is exactly one place an asset's\npath/hash/page can drift out of sync.",
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "type": {
          "const": "asset",
          "default": "asset",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "AssetBlock",
      "type": "object"
    },
    "AssetExtractionMethod": {
      "enum": [
        "manual",
        "raster_crop",
        "vector_export",
        "ocr",
        "unknown",
        "pending"
      ],
      "title": "AssetExtractionMethod",
      "type": "string"
    },
    "AssetType": {
      "enum": [
        "image",
        "diagram",
        "graph",
        "table",
        "equation",
        "page_crop"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "AutomaticValidationStatus": {
      "description": "Outcome of the pipeline's own mechanical checks (see validator.py) -\nschema shape, alternative sequence, asset counts/hashes, answer linkage.\nDeliberately separate from ``VisualValidationStatus``: passing every\nmechanical check is necessary but not sufficient for ``verified`` (see\ndocs/decisions.md, Phase 1B section 12/13) - it says nothing about\nwhether the text a human actually reads matches the PDF.",
      "enum": [
        "pending",
        "passed",
        "failed"
      ],
      "title": "AutomaticValidationStatus",
      "type": "string"
    },
    "CodeBlock": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "text": {
          "description": "verbatim, newline-joined; never reformatted",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "code",
          "default": "code",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CodeBlock",
      "type": "object"
    },
    "CourseCode": {
      "description": "Computing-area undergraduate courses/modalities present in the corpus.\n\n``ALL_COMPUTING`` is a deliberate alias meaning \"applies to every\ncomputing course in the given exam booklet\" (e.g. Formacao Geral and\nComponente Especifico Comum in the unified 2011 booklet). It exists so\na question does not need to enumerate every concrete course by hand.\nSee docs/decisions.md (ADR on applicable_courses) for the constraint\nthat ``ALL_COMPUTING`` may not be combined with other explicit codes.",
      "enum": [
        "ciencia-da-computacao-bacharelado",
        "ciencia-da-computacao-licenciatura",
        "engenharia-da-computacao",
        "sistemas-de-informacao",
        "all-computing"
      ],
      "title": "CourseCode",
      "type": "string"
    },
    "DifficultyLevel": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ],
      "title": "DifficultyLevel",
      "type": "string"
    },
    "ExtractionMethod": {
      "enum": [
        "manual",
        "text_layer",
        "ocr",
        "hybrid",
        "unknown",
        "pending"
      ],
      "title": "ExtractionMethod",
      "type": "string"
    },
    "ExtractionStatus": {
      "enum": [
        "pending",
        "extracted",
        "needs_review",
        "verified"
      ],
      "title": "ExtractionStatus",
      "type": "string"
    },
    "ParagraphBlock": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "paragraph",
          "default": "paragraph",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ParagraphBlock",
      "type": "object"
    },
    "QuestionType": {
      "enum": [
        "multiple_choice",
        "discursive",
        "perception_survey"
      ],
      "title": "QuestionType",
      "type": "string"
    },
    "SourceOccurrence": {
      "additionalProperties": false,
      "description": "One concrete appearance of a canonical question inside a source PDF.\n\nA canonical question may have several of these (see docs/data-contract.md\n- \"source occurrences and duplicates\"): the same question can be printed\nverbatim in more than one exam booklet/year.",
      "properties": {
        "exam_id": {
          "description": "manifest exam bundle id, e.g. 'enade-2021-cc-b'",
          "title": "Exam Id",
          "type": "string"
        },
        "pages": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        },
        "pdf_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pdf Sha256",
          "type": "string"
        },
        "question_number": {
          "minimum": 1,
          "title": "Question Number",
          "type": "integer"
        },
        "section": {
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "source_path": {
          "description": "path relative to the repo root",
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "exam_id",
        "pdf_sha256",
        "source_path",
        "pages",
        "question_number",
        "section"
      ],
      "title": "SourceOccurrence",
      "type": "object"
    },
    "TableBlock": {
      "additionalProperties": false,
      "description": "A table transcribed cell-by-cell from glyph geometry (never from the\nlogical/mathematical meaning of its contents - PROMPT section 5.3: \"Não\nuse o significado lógico das fórmulas para preencher células\").\n\n``validation_status`` records whether every cell was confirmed against\nthe rendered PDF (see docs/decisions.md ADR 12): a table that has not\npassed that check must never be presented as if it were reliable - see\n``Question._validate_content_blocks`` in question.py, which requires an\naccompanying visual-fallback asset whenever a `TableBlock` is not\n`verified`.",
      "properties": {
        "headers": {
          "items": {
            "type": "string"
          },
          "title": "Headers",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "type": {
          "const": "table",
          "default": "table",
          "title": "Type",
          "type": "string"
        },
        "validation_status": {
          "$ref": "#/$defs/TableValidationStatus",
          "default": "needs_review"
        }
      },
      "required": [
        "rows"
      ],
      "title": "TableBlock",
      "type": "object"
    },
    "TableValidationStatus": {
      "description": "Whether a structured ``TableBlock`` was confirmed cell-by-cell\nagainst the source PDF (PROMPT Phase 1C section 5.4/21). A table whose\ngeometry could not be validated must never be presented as if it were\na reliable transcription - see ``ContentBlock`` (content_block.py).",
      "enum": [
        "verified",
        "needs_review"
      ],
      "title": "TableValidationStatus",
      "type": "string"
    },
    "TaxonomyReviewStatus": {
      "enum": [
        "pending",
        "draft",
        "reviewed"
      ],
      "title": "TaxonomyReviewStatus",
      "type": "string"
    },
    "VisualValidationStatus": {
      "description": "Outcome of an actual human/reviewer visual comparison against the\nrendered PDF page(s). ``NOT_PERFORMED`` is the only honest default - a\npipeline run alone must never claim this passed (PROMPT section 12:\n\"Não declarar visual_validation=passed se nenhuma imagem/PDF foi de\nfato inspecionada\").",
      "enum": [
        "not_performed",
        "passed",
        "failed"
      ],
      "title": "VisualValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alternative_diagnostics": {
      "additionalProperties": {
        "$ref": "#/$defs/AlternativeDiagnostic"
      },
      "title": "Alternative Diagnostics",
      "type": "object"
    },
    "alternatives": {
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "answer_standard": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnswerStandardReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "official grading rubric for discursive questions (see docs/decisions.md)"
    },
    "answer_validation_status": {
      "$ref": "#/$defs/AnswerValidationStatus",
      "default": "pending"
    },
    "applicable_courses": {
      "items": {
        "$ref": "#/$defs/CourseCode"
      },
      "minItems": 1,
      "title": "Applicable Courses",
      "type": "array"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "title": "Assets",
      "type": "array"
    },
    "automatic_validation": {
      "$ref": "#/$defs/AutomaticValidationStatus",
      "default": "pending"
    },
    "competencies": {
      "items": {
        "type": "string"
      },
      "title": "Competencies",
      "type": "array"
    },
    "concepts": {
      "items": {
        "type": "string"
      },
      "title": "Concepts",
      "type": "array"
    },
    "content_blocks": {
      "anyOf": [
        {
          "items": {
            "discriminator": {
              "mapping": {
                "asset": "#/$defs/AssetBlock",
                "code": "#/$defs/CodeBlock",
                "paragraph": "#/$defs/ParagraphBlock",
                "table": "#/$defs/TableBlock"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ParagraphBlock"
              },
              {
                "$ref": "#/$defs/CodeBlock"
              },
              {
                "$ref": "#/$defs/TableBlock"
              },
              {
                "$ref": "#/$defs/AssetBlock"
              }
            ]
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Blocks"
    },
    "correct_answer": {
      "anyOf": [
        {
          "pattern": "^[A-E]$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correct Answer"
    },
    "difficulty": {
      "anyOf": [
        {
          "$ref": "#/$defs/DifficultyLevel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exam_year": {
      "maximum": 2100,
      "minimum": 1990,
      "title": "Exam Year",
      "type": "integer"
    },
    "extraction_method": {
      "$ref": "#/$defs/ExtractionMethod",
      "default": "pending"
    },
    "extraction_status": {
      "$ref": "#/$defs/ExtractionStatus",
      "default": "pending"
    },
    "id": {
      "description": "e.g. 'enade-2021-cc-b-q12', see docs/data-contract.md",
      "title": "Id",
      "type": "string"
    },
    "keywords": {
      "items": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "array"
    },
    "ocr_confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ocr Confidence"
    },
    "official_answer_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "reference (e.g. exam_id/path) to the gabarito this was validated against",
      "title": "Official Answer Source"
    },
    "prerequisites": {
      "items": {
        "type": "string"
      },
      "title": "Prerequisites",
      "type": "array"
    },
    "question_number": {
      "minimum": 1,
      "title": "Question Number",
      "type": "integer"
    },
    "question_type": {
      "$ref": "#/$defs/QuestionType"
    },
    "section": {
      "minLength": 1,
      "title": "Section",
      "type": "string"
    },
    "source_occurrences": {
      "items": {
        "$ref": "#/$defs/SourceOccurrence"
      },
      "minItems": 1,
      "title": "Source Occurrences",
      "type": "array"
    },
    "statement": {
      "minLength": 1,
      "title": "Statement",
      "type": "string"
    },
    "subjects": {
      "items": {
        "type": "string"
      },
      "title": "Subjects",
      "type": "array"
    },
    "taxonomy_review_status": {
      "$ref": "#/$defs/TaxonomyReviewStatus",
      "default": "pending"
    },
    "topics": {
      "items": {
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    },
    "visual_validation": {
      "$ref": "#/$defs/VisualValidationStatus",
      "default": "not_performed"
    }
  },
  "required": [
    "id",
    "exam_year",
    "source_occurrences",
    "applicable_courses",
    "section",
    "question_number",
    "question_type",
    "statement"
  ],
  "title": "Question",
  "type": "object"
}
