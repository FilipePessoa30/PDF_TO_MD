# --- Raw / cached source corpus -------------------------------------------
# The pristine clone of https://github.com/geacc/enade (and any other raw
# source PDFs) lives under data/raw/. It is large, binary, and fully
# reproducible via `python scripts/fetch_corpus.py`, so it is never committed.
data/raw/

# Canonical question assets (rendered PNG crops under
# data/questions/<year>/<course>/<question-id>/*.png) are deliberately NOT
# ignored - they are referenced by the canonical Markdown's own image links
# and are part of the dataset (see docs/decisions.md, Phase 1B).

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Editors / OS -------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Scratch --------------------------------------------------------------
# Ad hoc investigation output (full-page renders, rejected candidate crops,
# raw-text dumps) produced while auditing extraction quality - never a
# source of truth, always reproducible from the raw PDF. All such work uses
# this one directory name by convention so nothing needs a bespoke rule.
.scratch/
*.tmp
*.bak
